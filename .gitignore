@'
# Dependencies
**/node_modules/

# Build output
**/dist/
**/build/

# TypeScript
**/*.tsbuildinfo

# Environment variables
**/.env
**/.env.*
!**/.env.example

# Logs
**/*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Coverage
**/coverage/

# Temporary files
**/*.tmp
**/*.temp
'@ | Set-Content .gitignore